version: '3.9'

services:
  web:
    image: php:8.2-apache
    container_name: layne-consulting-website
    ports:
      - "8383:80"
    volumes:
      - /automation/docker/layne-website:/var/www/html
    restart: unless-stopped
    environment:
      SMTP_USER: "bocaspbx@gmail.com"       # optional, for send-email.php
      SMTP_PASS: "pmrkjpbloapcdkaf"         # optional, for send-email.php
      TURNSTILE_SECRET: "0x4AAAAAAB3tkQ6AiHnOoToaY02RYWVJyQo"    # Cloudflare secret
    command: >
      bash -c "
      apt-get update && 
      apt-get install -y unzip git && 
      rm -rf /var/lib/apt/lists/* &&
      docker-php-ext-install mysqli &&
      a2enmod rewrite &&
      cd /var/www/html &&
      if [ ! -d vendor ]; then
        php -r \"copy('https://getcomposer.org/installer','composer-setup.php');\" &&
        php composer-setup.php --install-dir=/usr/local/bin --filename=composer &&
        php -r \"unlink('composer-setup.php');\" &&
        composer require phpmailer/phpmailer
      fi &&
      apache2-foreground
      "
    networks: 
      - dockernet
networks: 
  dockernet: 
    external: true
